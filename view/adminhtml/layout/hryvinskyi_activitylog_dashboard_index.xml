<!--
    A module adds a header button by adding a block to "dashboard.actions", and a widget through the "widgets"
    argument of Hryvinskyi\ActivityLog\Model\Dashboard\WidgetPool in its di.xml.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hryvinskyi_activitylog_menu"/>
    <head>
        <css src="Hryvinskyi_ActivityLog::css/activity-log.css"/>
        <css src="Hryvinskyi_ActivityLog::css/dashboard.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="activity.dashboard"
                   template="Hryvinskyi_ActivityLog::dashboard/dashboard.phtml">
                <arguments>
                    <argument name="page" xsi:type="object">Hryvinskyi\ActivityLog\ViewModel\DashboardPage</argument>
                    <argument name="icons" xsi:type="object">Hryvinskyi\ActivityLog\Api\IconsInterface</argument>
                </arguments>
                <container name="dashboard.actions" as="dashboard.actions"/>
            </block>
        </referenceContainer>
    </body>
</page>
