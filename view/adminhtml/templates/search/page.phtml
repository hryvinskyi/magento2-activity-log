declare(strict_types=1);

use Hryvinskyi\ActivityLog\Api\IconsInterface;
use Hryvinskyi\ActivityLog\ViewModel\SearchPage;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/**
 * The activity search page
 *
 * The results area (data-role "search-results") holds the two views of one search: "timeline-view", empty until a
 * timeline is mounted there, and "grid-view", the activity grid (the child "activity.grid"). The page announces every
 * search on the results element; whatever shows results listens there.
 *
 * @var Template $block
 * @var Escaper $escaper
 */

$page = $block->getData('page');
if (!$page instanceof SearchPage) {
    return;
}
$icons = $block->getData('icons');
$icon = static fn (string $id, string $class): string => $icons instanceof IconsInterface
    ? $icons->render($id, $class)
    : '';
$opensGrid = $page->opensGrid();
?>
