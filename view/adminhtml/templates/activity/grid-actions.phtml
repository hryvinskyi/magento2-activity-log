declare(strict_types=1);

use Hryvinskyi\ActivityLog\Api\IconsInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/**
 * Page actions of the activity grid
 *
 * @var Template $block
 * @var Escaper $escaper
 */
$icons = $block->getData('icons');
$icon = static fn (string $id, string $class): string => $icons instanceof IconsInterface
    ? $icons->render($id, $class)
    : '';
$exportInit = [
    'Hryvinskyi_ActivityLog/js/grid/export-trigger' => [
        'exportButton' => 'hryvinskyi_activity_log_listing.hryvinskyi_activity_log_listing.listing_top.export_button',
        'option' => 'csv',
    ],
];
?>
<div class="activity-page-actions">
    <?= $block->getChildHtml() ?>
    <a class="activity-button" href="<?= $escaper->escapeUrl($block->getUrl('activitylog/dashboard/index')) ?>">
        <?= /* @noEscape */ $icon('Hryvinskyi_ActivityLog::layout-dashboard', 'activity-button__icon') ?>
        <?= $escaper->escapeHtml(__('View Dashboard')) ?>
    </a>
    <button type="button" class="activity-button activity-button--primary"
            data-mage-init='<?= $escaper->escapeHtmlAttr((string) json_encode($exportInit)) ?>'>
        <?= /* @noEscape */ $icon('Hryvinskyi_ActivityLog::download', 'activity-button__icon') ?>
        <?= $escaper->escapeHtml(__('Export CSV')) ?>
    </button>
</div>
