declare(strict_types=1);

use Hryvinskyi\ActivityLog\Api\IconsInterface;
use Hryvinskyi\ActivityLog\ViewModel\TimelineAssets;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/**
 * What the activity timeline renders with, printed once per page by the "hryvinskyi_activitylog_timeline_assets"
 * layout handle: its config (wording, verbs, channels, kinds of actor, outcomes) as JSON, and the element templates
 * it clones. A template's parts carry data-slot names the renderer fills with textContent; nothing in them is data.
 *
 * @var Template $block
 * @var Escaper $escaper
 */

$assets = $block->getData('assets');
if (!$assets instanceof TimelineAssets) {
    return;
}
$icons = $block->getData('icons');
$icon = static fn (string $id, string $class): string => $icons instanceof IconsInterface
    ? $icons->render($id, $class)
    : '';
?>
<div class="activity-stream-assets" data-role="activity-timeline-assets" hidden>
    <script type="application/json" data-role="activity-timeline-config">
        <?= /* @noEscape */ $assets->configJson() ?>
    </script>

    <template data-template="results">
        <div class="activity-stream" aria-busy="false">
            <div class="activity-stream__head" data-slot="head" hidden>
                <span aria-live="polite"><strong class="activity-stream__count" data-slot="count"></strong>
                    <span data-slot="noun"></span></span><span class="activity-stream__muted"
                                                               data-slot="span"></span>
            </div>
            <div class="activity-stream__notice" data-slot="notice" role="status" hidden></div>
            <div class="activity-stream__list" data-slot="list"></div>
