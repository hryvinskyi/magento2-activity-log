<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">hryvinskyi_activity_log_listing.hryvinskyi_activity_log_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>hryvinskyi_activity_log_columns</spinner>
        <deps>
            <dep>hryvinskyi_activity_log_listing.hryvinskyi_activity_log_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="hryvinskyi_activity_log_listing_data_source" component="Hryvinskyi_ActivityLog/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Hryvinskyi_ActivityLog::view</aclResource>
        <dataProvider class="Hryvinskyi\ActivityLog\Ui\DataProvider\ActivityListingDataProvider"
                      name="hryvinskyi_activity_log_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <exportButton name="export_button">
            <settings>
                <options>
                    <option name="csv" xsi:type="array">
                        <item name="value" xsi:type="string">csv</item>
                        <item name="label" xsi:type="string" translate="true">CSV</item>
                        <item name="url" xsi:type="string">mui/export/gridToCsv</item>
                    </option>
                </options>
            </settings>
        </exportButton>
        <columnsControls name="columns_controls"/>
        <massaction name="listing_massaction" class="Hryvinskyi\ActivityLog\Ui\Component\AclMassAction">
            <action name="delete">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="aclResource" xsi:type="string">Hryvinskyi_ActivityLog::delete</item>
                    </item>
                </argument>
                <settings>
                    <confirm>
                        <message translate="true">Selected activities will be removed from the journal permanently. Linked activities in the same operation are kept.</message>
                        <title translate="true">Delete activities?</title>
                    </confirm>
                    <url path="hryvinskyi_activitylog/activity/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging" component="Hryvinskyi_ActivityLog/js/grid/paging"/>
    </listingToolbar>
    <columns name="hryvinskyi_activity_log_columns" component="Hryvinskyi_ActivityLog/js/grid/listing">
        <column name="operation" class="Hryvinskyi\ActivityLog\Ui\Component\Listing\Column\ActivityColumn"
                component="Hryvinskyi_ActivityLog/js/grid/columns/operation-rule" sortOrder="1">
            <settings>
                <label/>
                <sortable>false</sortable>
                <draggable>false</draggable>
                <controlVisibility>false</controlVisibility>
                <fieldClass>
                    <class name="activity-log-operation-cell">true</class>
                </fieldClass>
            </settings>
        </column>
        <selectionsColumn name="ids" component="Hryvinskyi_ActivityLog/js/grid/columns/selections" sortOrder="5">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="occurred_at_ms" class="Hryvinskyi\ActivityLog\Ui\Component\Listing\Column\ActivityColumn" component="Hryvinskyi_ActivityLog/js/grid/columns/time" sortOrder="10">
            <settings>
                <label translate="true">Time</label>
                <sorting>desc</sorting>
                <controlVisibility>false</controlVisibility>
            </settings>
        </column>
        <column name="channel" class="Hryvinskyi\ActivityLog\Ui\Component\Listing\Column\ActivityColumn"
                component="Hryvinskyi_ActivityLog/js/grid/columns/channel" sortOrder="20">
            <settings>
                <label translate="true">Channel</label>
                <options class="Hryvinskyi\ActivityLog\Model\Source\ChannelOptions"/>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="actor_name" class="Hryvinskyi\ActivityLog\Ui\Component\Listing\Column\ActivityColumn" component="Hryvinskyi_ActivityLog/js/grid/columns/actor" sortOrder="30">
            <settings>
                <label translate="true">Actor</label>
            </settings>
        </column>
        <column name="action" class="Hryvinskyi\ActivityLog\Ui\Component\Listing\Column\ActivityColumn" component="Hryvinskyi_ActivityLog/js/grid/columns/action" sortOrder="40">
            <settings>
                <label translate="true">Action</label>
            </settings>
        </column>
        <column name="subject_label" sortOrder="50">
            <settings>
                <label translate="true">Subject</label>
                <fieldClass>
                    <class name="activity-log-subject-cell">true</class>
                </fieldClass>
            </settings>
        </column>
        <column name="change_field" component="Hryvinskyi_ActivityLog/js/grid/columns/change-field" sortOrder="52">
            <settings>
                <label translate="true">Field</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="change_values" component="Hryvinskyi_ActivityLog/js/grid/columns/change-values" sortOrder="54">
            <settings>
                <label translate="true">Before → After</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="outcome" class="Hryvinskyi\ActivityLog\Ui\Component\Listing\Column\ActivityColumn" component="Hryvinskyi_ActivityLog/js/grid/columns/outcome" sortOrder="60">
            <settings>
                <label translate="true">Outcome</label>
                <options class="Hryvinskyi\ActivityLog\Model\Source\OutcomeOptions"/>
                <dataType>select</dataType>
            </settings>
        </column>
        <column name="change_scope" sortOrder="65">
            <settings>
                <label translate="true">Scope</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="duration_ms" class="Hryvinskyi\ActivityLog\Ui\Component\Listing\Column\ActivityColumn" component="Hryvinskyi_ActivityLog/js/grid/columns/duration" sortOrder="70">
            <settings>
                <label translate="true">Duration</label>
                <visible>false</visible>
                <fieldClass>
                    <class name="activity-log-number-cell">true</class>
                </fieldClass>
            </settings>
        </column>
        <column name="store_id" component="Magento_Ui/js/grid/columns/select" sortOrder="80">
            <settings>
                <label translate="true">Store View</label>
                <visible>false</visible>
                <options class="Magento\Store\Ui\Component\Listing\Column\Store\Options"/>
                <dataType>select</dataType>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="ip" sortOrder="90">
            <settings>
                <label translate="true">IP</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="user_agent" sortOrder="100">
            <settings>
                <label translate="true">User Agent</label>
                <visible>false</visible>
                <fieldClass>
                    <class name="activity-log-user-agent-cell">true</class>
                </fieldClass>
            </settings>
        </column>
        <column name="correlation_id" class="Hryvinskyi\ActivityLog\Ui\Component\Listing\Column\ActivityColumn" component="Hryvinskyi_ActivityLog/js/grid/columns/correlation" sortOrder="110">
            <settings>
                <label translate="true">Correlation ID</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="correlation_full" sortOrder="120">
            <settings>
                <label translate="true">Full Correlation ID</label>
                <visible>false</visible>
                <sortable>false</sortable>
                <fieldClass>
                    <class name="activity-log-mono-cell">true</class>
                </fieldClass>
            </settings>
        </column>
        <actionsColumn name="activity_actions" class="Hryvinskyi\ActivityLog\Ui\Component\Listing\Column\ActivityActions"
                       component="Hryvinskyi_ActivityLog/js/grid/columns/activity-actions" sortOrder="200">
            <settings>
                <label translate="true">Action</label>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
