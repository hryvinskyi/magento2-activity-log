<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Hryvinskyi\ActivityLog\Api\Data\ActivityInterface" type="Hryvinskyi\ActivityLog\Model\Data\Activity"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\ActorInterface" type="Hryvinskyi\ActivityLog\Model\Data\Actor"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\SubjectInterface" type="Hryvinskyi\ActivityLog\Model\Data\Subject"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\OriginInterface" type="Hryvinskyi\ActivityLog\Model\Data\Origin"/>
    <preference for="Hryvinskyi\ActivityLog\Api\ActivityRecorderInterface" type="Hryvinskyi\ActivityLog\Model\ActivityRecorder"/>
    <preference for="Hryvinskyi\ActivityLog\Api\IconsInterface" type="Hryvinskyi\ActivityLog\ViewModel\Icons"/>
    <preference for="Hryvinskyi\ActivityLog\Api\ActivityBuilderInterface" type="Hryvinskyi\ActivityLog\Model\ActivityBuilder"/>
    <preference for="Hryvinskyi\ActivityLog\Api\ActivityRepositoryInterface" type="Hryvinskyi\ActivityLog\Model\ActivityRepository"/>
    <preference for="Hryvinskyi\ActivityLog\Api\ActorContextInterface" type="Hryvinskyi\ActivityLog\Model\Actor\ActorContext"/>
    <preference for="Hryvinskyi\ActivityLog\Api\CorrelationScopeInterface" type="Hryvinskyi\ActivityLog\Model\Correlation\CorrelationScope"/>
    <preference for="Hryvinskyi\ActivityLog\Api\SanitizerInterface" type="Hryvinskyi\ActivityLog\Model\Sanitizer\Sanitizer"/>
    <preference for="Hryvinskyi\ActivityLog\Api\ChannelPoolInterface" type="Hryvinskyi\ActivityLog\Model\Channel\ChannelPool"/>
    <preference for="Hryvinskyi\ActivityLog\Api\ConfigInterface" type="Hryvinskyi\ActivityLog\Model\Config"/>
    <preference for="Hryvinskyi\ActivityLog\Model\Correlation\IdGeneratorInterface" type="Hryvinskyi\ActivityLog\Model\Correlation\RandomIdGenerator"/>
    <preference for="Hryvinskyi\ActivityLog\Model\Correlation\IncomingIdInterface" type="Hryvinskyi\ActivityLog\Model\Correlation\HttpHeaderIncomingId"/>
    <preference for="Hryvinskyi\ActivityLog\Model\Origin\OriginResolverInterface" type="Hryvinskyi\ActivityLog\Model\Origin\RequestOriginResolver"/>
    <preference for="Hryvinskyi\ActivityLog\Api\MillisecondClockInterface" type="Hryvinskyi\ActivityLog\Model\Clock\SystemMillisecondClock"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\DashboardQueryInterface" type="Hryvinskyi\ActivityLog\Model\Data\DashboardQuery"/>
    <preference for="Hryvinskyi\ActivityLog\Api\ActivityPrunerInterface" type="Hryvinskyi\ActivityLog\Model\Retention\ActivityPruner"/>
    <preference for="Hryvinskyi\ActivityLog\Api\ActivityStatisticsInterface" type="Hryvinskyi\ActivityLog\Model\ResourceModel\ActivityStatistics"/>
    <preference for="Hryvinskyi\ActivityLog\Model\Dashboard\PreferenceStorageInterface" type="Hryvinskyi\ActivityLog\Model\Dashboard\BookmarkPreferenceStorage"/>
    <preference for="Hryvinskyi\ActivityLog\Model\Search\Preference\SearchPreferenceStorageInterface" type="Hryvinskyi\ActivityLog\Model\Search\Preference\BookmarkSearchPreferenceStorage"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Search\ActivitySearchInterface" type="Hryvinskyi\ActivityLog\Model\Search\ActivitySearch"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Search\SubjectLookupInterface" type="Hryvinskyi\ActivityLog\Model\ResourceModel\SubjectLookup"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Search\RecentSubjectsInterface" type="Hryvinskyi\ActivityLog\Model\ResourceModel\RecentSubjects"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Search\ActivityActorsInterface" type="Hryvinskyi\ActivityLog\Model\ResourceModel\ActivityActors"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Search\ActivityFactsInterface" type="Hryvinskyi\ActivityLog\Model\ResourceModel\ActivityFacts"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\ActivityFactInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\ActivityFact"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\SearchRequestInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\SearchRequest"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\SearchCriterionInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\SearchCriterion"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\SearchCursorInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\SearchCursor"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\SearchCountInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\SearchCount"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\SearchPageInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\SearchPage"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\EventViewInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\EventView"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\EventDetailInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\EventDetail"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\FieldChangeInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\FieldChange"/>
    <preference for="Hryvinskyi\ActivityLog\Api\Data\Search\SuggestionInterface" type="Hryvinskyi\ActivityLog\Model\Data\Search\Suggestion"/>

    <!-- Suggestions of the search bar: providers are read through the cache, one entry per provider and locale -->
    <preference for="Hryvinskyi\ActivityLog\Model\Search\Suggestion\SuggestionReaderInterface" type="Hryvinskyi\ActivityLog\Model\Search\Suggestion\CachedSuggestionReader"/>
    <type name="Hryvinskyi\ActivityLog\Model\Search\Suggestion\CachedSuggestionReader">
        <arguments>
            <argument name="inner" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\Suggestion\ProviderReader</argument>
            <argument name="cache" xsi:type="object">Hryvinskyi\ActivityLog\Model\Cache\Type\SearchCache</argument>
        </arguments>
    </type>
    <!-- Values of the journal's keys; other modules add providers of their keys -->
    <type name="Hryvinskyi\ActivityLog\Model\Search\SuggestionPool">
        <arguments>
            <argument name="suggestionProviders" xsi:type="array">
                <item name="journal_actors" xsi:type="object" sortOrder="100">Hryvinskyi\ActivityLog\Model\Search\Suggestion\Journal\ActorSuggestions</item>
                <item name="journal_via_clients" xsi:type="object" sortOrder="110">Hryvinskyi\ActivityLog\Model\Search\Suggestion\Journal\ViaClientSuggestions</item>
                <item name="journal_channels" xsi:type="object" sortOrder="120">Hryvinskyi\ActivityLog\Model\Search\Suggestion\Journal\ChannelSuggestions</item>
                <item name="journal_outcomes" xsi:type="object" sortOrder="130">Hryvinskyi\ActivityLog\Model\Search\Suggestion\Journal\OutcomeSuggestions</item>
                <item name="journal_store_views" xsi:type="object" sortOrder="140">Hryvinskyi\ActivityLog\Model\Search\Suggestion\Journal\StoreViewSuggestions</item>
            </argument>
        </arguments>
    </type>

    <!-- Search keys answered from the journal's own columns; other modules add to "conditions" -->
    <type name="Hryvinskyi\ActivityLog\Model\Search\ConditionPool">
        <arguments>
            <argument name="journalConditions" xsi:type="array">
                <item name="by" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\Journal\ActorCondition</item>
                <item name="via" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\Journal\ViaClientCondition</item>
                <item name="channel" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\Journal\ChannelCondition</item>
                <item name="outcome" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\Journal\OutcomeCondition</item>
                <item name="store" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\Journal\StoreCondition</item>
                <item name="request" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\Journal\CorrelationCondition</item>
                <item name="text" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\Journal\KeywordCondition</item>
            </argument>
        </arguments>
    </type>

    <!-- How the journal's keys are presented; other modules add their keys' descriptions -->
    <type name="Hryvinskyi\ActivityLog\Model\Search\KeyDescriptionPool">
        <arguments>
            <argument name="keyDescriptions" xsi:type="array">
                <item name="by" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Actor</item>
                <item name="via" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\KeyDescription\ViaClient</item>
                <item name="channel" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Channel</item>
                <item name="outcome" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Outcome</item>
                <item name="store" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Store</item>
                <item name="request" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Request</item>
                <item name="text" xsi:type="object">Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Text</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Actor"
                 type="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\KeyDescription">
        <arguments>
            <argument name="key" xsi:type="string">by</argument>
            <argument name="label" xsi:type="string" translate="true">Actor</argument>
            <argument name="hint" xsi:type="string" translate="true">Name, or a kind of actor: admin, integration, customer, cli, cron; &quot;name&quot; for exactly that person</argument>
            <argument name="sortOrder" xsi:type="number">100</argument>
            <argument name="group" xsi:type="string">people</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\ViaClient"
                 type="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\KeyDescription">
        <arguments>
            <argument name="key" xsi:type="string">via</argument>
            <argument name="label" xsi:type="string" translate="true">Client</argument>
            <argument name="hint" xsi:type="string" translate="true">The client an actor worked through</argument>
            <argument name="sortOrder" xsi:type="number">110</argument>
            <argument name="group" xsi:type="string">people</argument>
            <argument name="inPanel" xsi:type="boolean">false</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Channel"
                 type="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\KeyDescription">
        <arguments>
            <argument name="key" xsi:type="string">channel</argument>
            <argument name="label" xsi:type="string" translate="true">Channel</argument>
            <argument name="hint" xsi:type="string" translate="true">Where the activity came from</argument>
            <argument name="control" xsi:type="string">select</argument>
            <argument name="sortOrder" xsi:type="number">120</argument>
            <argument name="options" xsi:type="object">Hryvinskyi\ActivityLog\Model\Source\ChannelOptions</argument>
            <argument name="group" xsi:type="string">other</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Outcome"
                 type="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\KeyDescription">
        <arguments>
            <argument name="key" xsi:type="string">outcome</argument>
            <argument name="label" xsi:type="string" translate="true">Outcome</argument>
            <argument name="hint" xsi:type="string" translate="true">Success, failure or denied</argument>
            <argument name="control" xsi:type="string">select</argument>
            <argument name="sortOrder" xsi:type="number">130</argument>
            <argument name="options" xsi:type="object">Hryvinskyi\ActivityLog\Model\Source\OutcomeOptions</argument>
            <argument name="group" xsi:type="string">other</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Store"
                 type="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\KeyDescription">
        <arguments>
            <argument name="key" xsi:type="string">store</argument>
            <argument name="label" xsi:type="string" translate="true">Scope / store view</argument>
            <argument name="hint" xsi:type="string" translate="true">Store view code or name; a | b for any of them</argument>
            <argument name="sortOrder" xsi:type="number">140</argument>
            <argument name="group" xsi:type="string">other</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Request"
                 type="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\KeyDescription">
        <arguments>
            <argument name="key" xsi:type="string">request</argument>
            <argument name="label" xsi:type="string" translate="true">Request</argument>
            <argument name="hint" xsi:type="string" translate="true">Correlation ID shared by everything one request did</argument>
            <argument name="sortOrder" xsi:type="number">150</argument>
            <argument name="group" xsi:type="string">other</argument>
            <argument name="inPanel" xsi:type="boolean">false</argument>
        </arguments>
    </virtualType>
    <virtualType name="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\Text"
                 type="Hryvinskyi\ActivityLog\Model\Search\KeyDescription\KeyDescription">
        <arguments>
            <argument name="key" xsi:type="string">text</argument>
            <argument name="label" xsi:type="string" translate="true">Text</argument>
            <argument name="hint" xsi:type="string" translate="true">Words anywhere in the activity</argument>
            <argument name="sortOrder" xsi:type="number">1000</argument>
            <argument name="group" xsi:type="string">other</argument>
            <argument name="inPanel" xsi:type="boolean">false</argument>
        </arguments>
    </virtualType>

    <type name="Hryvinskyi\ActivityLog\Model\Sanitizer\Sanitizer">
        <arguments>
            <!-- Secret whatever the configured list says; the configured names are added to these -->
            <argument name="mandatorySecretFields" xsi:type="array">
                <item name="password" xsi:type="string">password</item>
                <item name="token" xsi:type="string">token</item>
                <item name="secret" xsi:type="string">secret</item>
                <item name="authorization" xsi:type="string">authorization</item>
                <item name="cookie" xsi:type="string">cookie</item>
                <item name="api_key" xsi:type="string">api_key</item>
                <item name="apikey" xsi:type="string">apikey</item>
                <item name="private_key" xsi:type="string">private_key</item>
            </argument>
            <!-- Asked in order; a body none of them recognises is treated as plain text -->
            <argument name="bodyMaskers" xsi:type="array">
                <item name="json" xsi:type="object" sortOrder="10">Hryvinskyi\ActivityLog\Model\Sanitizer\Body\JsonBodyMasker</item>
                <item name="xml" xsi:type="object" sortOrder="20">Hryvinskyi\ActivityLog\Model\Sanitizer\Body\XmlBodyMasker</item>
                <item name="form" xsi:type="object" sortOrder="30">Hryvinskyi\ActivityLog\Model\Sanitizer\Body\FormBodyMasker</item>
            </argument>
        </arguments>
    </type>

    <type name="Hryvinskyi\ActivityLog\Model\Dashboard\WidgetPool">
        <arguments>
            <argument name="widgets" xsi:type="array">
                <item name="volume" xsi:type="object" sortOrder="10">Hryvinskyi\ActivityLog\Model\Dashboard\Widget\VolumeWidget</item>
                <item name="slowest_actions" xsi:type="object" sortOrder="20">Hryvinskyi\ActivityLog\Model\Dashboard\Widget\SlowestActionsWidget</item>
                <item name="top_actors" xsi:type="object" sortOrder="30">Hryvinskyi\ActivityLog\Model\Dashboard\Widget\TopActorsWidget</item>
            </argument>
        </arguments>
    </type>

    <type name="Hryvinskyi\ActivityLog\Model\Actor\ActorContext">
        <arguments>
            <argument name="resolvers" xsi:type="array">
                <item name="user_context" xsi:type="object" sortOrder="100">Hryvinskyi\ActivityLog\Model\Actor\Resolver\UserContextActorResolver</item>
                <item name="process" xsi:type="object" sortOrder="200">Hryvinskyi\ActivityLog\Model\Actor\Resolver\ProcessActorResolver</item>
            </argument>
        </arguments>
    </type>

    <!-- Proxies: an account's repository is built only when an activity names that kind of account -->
    <type name="Hryvinskyi\ActivityLog\Model\Actor\Resolver\UserContextActorResolver">
        <arguments>
            <argument name="nameLookups" xsi:type="array">
                <item name="1" xsi:type="object">Hryvinskyi\ActivityLog\Model\Actor\NameLookup\IntegrationNameLookup\Proxy</item>
                <item name="2" xsi:type="object">Hryvinskyi\ActivityLog\Model\Actor\NameLookup\AdminUserNameLookup\Proxy</item>
                <item name="3" xsi:type="object">Hryvinskyi\ActivityLog\Model\Actor\NameLookup\CustomerNameLookup\Proxy</item>
            </argument>
        </arguments>
    </type>

    <type name="Hryvinskyi\ActivityLog\Model\ResourceModel\Activity\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">hryvinskyi_activity_log</argument>
            <argument name="resourceModel" xsi:type="string">Hryvinskyi\ActivityLog\Model\ResourceModel\Activity</argument>
        </arguments>
    </type>
    <!-- The activity grid's search, applied to its collection as one condition; a proxy, so other grids sharing the
         pool never build the search -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="activity_search" xsi:type="object">Hryvinskyi\ActivityLog\Ui\DataProvider\ActivitySearchFilter\Proxy</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="hryvinskyi_activity_log_listing_data_source" xsi:type="string">Hryvinskyi\ActivityLog\Model\ResourceModel\Activity\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <type name="Hryvinskyi\ActivityLog\Cron\ApplyRetention">
        <arguments>
            <argument name="purgers" xsi:type="array">
                <item name="journal" xsi:type="object" sortOrder="1000">Hryvinskyi\ActivityLog\Model\Retention\JournalPurger</item>
            </argument>
        </arguments>
    </type>

    <!-- Settings are saved from the command line too, where only global wiring exists -->
    <virtualType name="Hryvinskyi\ActivityLog\Model\Config\Backend\SecretFieldList"
                 type="Hryvinskyi\ConfigurationFields\Model\Config\Backend\TagList">
        <arguments>
            <argument name="tagListConfig" xsi:type="array">
                <item name="separator" xsi:type="string">,</item>
            </argument>
        </arguments>
    </virtualType>
</config>
