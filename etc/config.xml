<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <hryvinskyi_activity_log>
            <general>
                <enabled>1</enabled>
            </general>
            <security>
                <secret_fields>password,passwd,token,authorization,api_key,apikey,secret,access_token,refresh_token,private_key,client_secret,card_number,cc_number,cvv,cid,ssn,form_key</secret_fields>
            </security>
            <retention>
                <orphan_days>90</orphan_days>
            </retention>
        </hryvinskyi_activity_log>
    </default>
</config>
