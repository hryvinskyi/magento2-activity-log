<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::system">
                    <resource id="Hryvinskyi_ActivityLog::activity_log" title="Activity Log" translate="title" sortOrder="15">
                        <resource id="Hryvinskyi_ActivityLog::dashboard" title="Dashboard" translate="title" sortOrder="10"/>
                        <resource id="Hryvinskyi_ActivityLog::view" title="View Activity" translate="title" sortOrder="20"/>
                        <resource id="Hryvinskyi_ActivityLog::delete" title="Delete Activity" translate="title" sortOrder="30"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Hryvinskyi_ActivityLog::config" title="Activity Log Settings" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
